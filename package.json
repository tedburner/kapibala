{
  "name": "kapibala-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Kapibala (kpbl) - Production-grade TypeScript AI Agent Harness",
  "license": "MIT",
  "author": "tedburner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedburner/kapibala.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.check.json && pnpm typecheck:view-model && pnpm typecheck:protocol && pnpm typecheck:desktop",
    "typecheck:view-model": "tsc -p packages/cli/tsconfig.view-model.json",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "check-architecture": "tsx scripts/check-core-boundary.ts",
    "check-cli-boundary": "tsx scripts/check-cli-boundary.ts",
    "check-view-model": "pnpm --filter @kiturone/kapibala-cli build:view-model && tsx scripts/check-view-model.ts",
    "check-secrets": "tsx scripts/check-secrets.ts",
    "check-public-api": "tsx scripts/check-public-api.ts",
    "check-protocol-contract": "tsx scripts/check-protocol-contract.ts",
    "lint": "pnpm check-architecture && pnpm check-cli-boundary && pnpm check-local-boundary && pnpm check-view-model && pnpm check-host && pnpm check-public-api && pnpm check-protocol-contract && pnpm check-secrets && pnpm check-desktop && biome check .",
    "format": "biome format --write .",
    "verify": "pnpm typecheck && pnpm test && pnpm lint",
    "verify:compat": "tsx scripts/verify-compat.ts",
    "verify:compat:prepare": "tsx scripts/verify-compat.ts --prepare",
    "verify:platform": "tsx scripts/verify-platform.ts",
    "verify:soak": "tsx scripts/verify-soak.ts",
    "verify:soak:nightly": "tsx scripts/verify-soak.ts --tier nightly",
    "verify:soak:release": "tsx scripts/verify-soak.ts --tier release",
    "verify:release-evidence": "tsx scripts/check-release-evidence.ts",
    "flow": "tsx scripts/flow.ts",
    "release": "tsx scripts/flow.ts release",
    "dev": "node scripts/dev.mjs",
    "dev:build": "node scripts/dev.mjs --no-start",
    "dev:cli": "pnpm --filter \"@kiturone/kapibala-cli\" dev",
    "link:cli": "cd packages/cli && npm link --force",
    "typecheck:protocol": "tsc -p packages/cli/tsconfig.protocol.json",
    "check-local-boundary": "tsx scripts/check-local-boundary.ts",
    "check-host": "pnpm --filter @kiturone/kapibala-cli build:host && tsx scripts/check-host.ts",
    "build:desktop": "node scripts/build.mjs --desktop",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "try:desktop": "node packages/desktop/scripts/try-packaged.mjs",
    "typecheck:desktop": "pnpm --filter @kiturone/kapibala-desktop typecheck",
    "check-desktop": "tsx scripts/check-desktop.ts",
    "verify:desktop": "pnpm build:desktop && pnpm typecheck:desktop && pnpm check-desktop --artifacts && pnpm exec vitest run packages/desktop/tests && pnpm --filter @kiturone/kapibala-desktop e2e",
    "pack:desktop": "tsx scripts/desktop-package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@kiturone/kapibala": "workspace:*",
    "@types/node": "^22.20.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
