{
  "name": "@kiturone/kapibala-cli",
  "version": "0.0.8",
  "description": "Interactive CLI for Kapibala (kpbl)",
  "license": "MIT",
  "author": "tedburner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedburner/kapibala.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kpbl": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./view-model": {
      "types": "./dist/view-model/index.d.ts",
      "import": "./dist/view-model/index.js",
      "default": "./dist/view-model/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup --config tsup.config.ts && pnpm build:view-model && pnpm build:protocol && pnpm build:client",
    "build:view-model": "tsup --config tsup.view-model.config.ts",
    "dev": "tsup --watch",
    "build:protocol": "tsup --config tsup.protocol.config.ts",
    "build:client": "tsup --config tsup.client.config.ts"
  },
  "dependencies": {
    "@kiturone/kapibala": "workspace:*",
    "@kiturone/kapibala-mcp": "workspace:*",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
