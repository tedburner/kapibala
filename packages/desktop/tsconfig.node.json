{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/agent-host/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "packaged-e2e/**/*.ts",
    "playwright.packaged.config.ts"
  ]
}
