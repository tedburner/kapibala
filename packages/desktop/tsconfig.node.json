{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron"],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@kiturone/kapibala": ["../core/src/index.ts"],
      "@kiturone/kapibala-cli/commands": ["../cli/src/commands/index.ts"],
      "@kiturone/kapibala-host/host": ["../host/src/host/index.ts"],
      "@kiturone/kapibala-host/internal": ["../host/src/internal.ts"],
      "@kiturone/kapibala-host/protocol": ["../host/src/protocol/index.ts"],
      "@kiturone/kapibala-host/view-model": ["../host/src/view-model/index.ts"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/agent-host/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "packaged-e2e/**/*.ts",
    "playwright.packaged.config.ts"
  ]
}
